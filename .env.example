# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration
# Leave CORE_DB_ENGINE unset to use SQLite (default)
# Set to django.db.backends.postgresql to use PostgreSQL

# Core Database (platform-level)
# For Docker: use CORE_DB_HOST=db
# For local: use CORE_DB_HOST=127.0.0.1
CORE_DB_ENGINE=django.db.backends.postgresql
CORE_DB_NAME=xtenant_core
CORE_DB_USER=postgres
CORE_DB_PASSWORD=your-postgres-password-here
CORE_DB_HOST=db
CORE_DB_PORT=5432

# Tenant Database Configuration
# Tenant databases are created dynamically, but these settings define
# the connection parameters for all tenant databases
# For Docker: use TENANT_DB_HOST=db
# For local: use TENANT_DB_HOST=127.0.0.1
TENANT_DB_ENGINE=django.db.backends.postgresql
TENANT_DB_USER=postgres
TENANT_DB_PASSWORD=your-postgres-password-here
TENANT_DB_HOST=db
TENANT_DB_PORT=5432

# JWT Settings (optional)
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
