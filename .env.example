# ===============================
# Core database configuration
# ===============================

# Database engine (PostgreSQL recommended for production)
CORE_DB_ENGINE=django.db.backends.postgresql
CORE_DB_NAME=xtenant_core
CORE_DB_USER=core_user
CORE_DB_PASSWORD=core_password_change_me
CORE_DB_HOST=localhost
CORE_DB_PORT=5432


# ===============================
# Tenant database configuration
# ===============================

# All tenant databases will be created dynamically
# using this base configuration
TENANT_DB_ENGINE=django.db.backends.postgresql
TENANT_DB_USER=tenant_user
TENANT_DB_PASSWORD=tenant_password_change_me
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432


# ===============================
# Django settings
# ===============================

DJANGO_SECRET_KEY=django_secret_key_change_me
DJANGO_DEBUG=1
